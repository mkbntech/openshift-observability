# Multi-stage build for Node.js 20 Frontend
FROM docker.io/library/node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev

FROM docker.io/library/node:20-alpine
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY package*.json ./
COPY server.js ./
COPY views ./views
COPY public ./public

# Ensure OpenShift arbitrary UID compatibility
RUN chown -R 1001:0 /app && chmod -R g=u /app
USER 1001

EXPOSE 3000
CMD ["node", "server.js"]
