# Multi-stage build for Java 21 Spring Boot
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder
WORKDIR /build
COPY pom.xml .
# Download dependencies layer
RUN mvn dependency:go-offline -B
COPY src ./src
RUN mvn clean package -DskipTests -B

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=builder /build/target/*.jar app.jar

# Minimal memory footprint configuration optimized for OpenShift Local (CRC)
ENV JAVA_TOOL_OPTIONS="-Xms64m -Xmx192m -XX:+UseSerialGC -XX:MaxRAMPercentage=75"

# Ensure OpenShift arbitrary UID compatibility
RUN chown -R 1001:0 /app && chmod -R g=u /app
USER 1001

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
